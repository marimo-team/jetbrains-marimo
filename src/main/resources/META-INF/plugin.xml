<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>io.marimo.notebook</id>
    <name>marimo</name>
    <vendor url="https://marimo.io" email="contact@marimo.io">marimo</vendor>
    <description><![CDATA[
        <p><a href="https://marimo.io">marimo</a> is a reactive Python notebook. This plugin brings
        the full marimo editor inside PyCharm, so you can open, edit, and run notebooks without
        leaving your IDE.</p>

        <p>marimo notebooks are stored as plain <code>.py</code> files — no JSON, no hidden output
        state — so they diff cleanly, review like code, and run as scripts. The plugin detects which
        Python files are marimo notebooks and opens them in a dedicated reactive editor tab;
        everything else opens in the normal Python editor.</p>

        <p><b>Features</b></p>
        <ul>
          <li><b>Reactive editor, in the IDE</b> — cells re-run automatically when their inputs change.</li>
          <li><b>Interactive widgets</b> — sliders, tables, plots, and other <code>mo.ui</code> elements work inline.</li>
          <li><b>SQL cells, variables, and dependency panels</b> — the full marimo experience.</li>
          <li><b>Runs on your project interpreter</b> — with a one-click offer to install marimo when it's missing.</li>
          <li><b>Isolated sandbox runs</b> — optionally launch a notebook in a one-off <a href="https://docs.astral.sh/uv/">uv</a> environment.</li>
          <li><b>Pair with marimo</b> — start a supported terminal AI harness, or copy the notebook's pairing prompt.</li>
          <li><b>Theme-aware</b> — notebooks set to marimo's <code>system</code> theme follow your IDE's
              light/dark theme as you switch it; a theme you pin to light or dark is respected.</li>
        </ul>

        <p><b>Requirements:</b> PyCharm 2026.1+ and a configured project interpreter. uv is optional,
        used only for sandbox runs.</p>

        <p>Open source — <a href="https://github.com/marimo-team/jetbrains-marimo">github.com/marimo-team/jetbrains-marimo</a>.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.python</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <resource-bundle>messages.MarimoBundle</resource-bundle>

    <extensionPoints>
        <extensionPoint qualifiedName="io.marimo.notebook.launchEnvContributor"
                        interface="io.marimo.notebook.launch.LaunchEnvContributor"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="io.marimo.notebook.editor.MarimoFileEditorProvider"/>
        <fileEditorProvider implementation="io.marimo.notebook.editor.source.MarimoSourceEditorProvider"/>
        <fileIconProvider implementation="io.marimo.notebook.editor.MarimoFileIconProvider"/>
        <toolWindow id="Marimo Sessions"
                    anchor="right"
                    icon="io.marimo.notebook.MarimoIcons.FILE"
                    factoryClass="io.marimo.notebook.editor.sessions.MarimoSessionsToolWindowFactory"/>
        <notificationGroup id="Marimo" displayType="BALLOON"/>
        <internalFileTemplate name="marimo Notebook"/>
        <applicationConfigurable
            parentId="tools"
            instance="io.marimo.notebook.settings.MarimoSettingsConfigurable"
            id="io.marimo.notebook.telemetry.settings"
            displayName="marimo"/>
    </extensions>

    <actions>
        <action id="Marimo.NewNotebook"
                class="io.marimo.notebook.editor.CreateMarimoNotebookAction"
                text="marimo Notebook"
                description="Create a new marimo notebook"
                icon="io.marimo.notebook.MarimoIcons.FILE">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>

        <action id="Marimo.OpenAsPythonFile"
                class="io.marimo.notebook.editor.OpenAsPythonFileAction"
                text="Open as Python File"
                description="Show this marimo notebook's raw Python source">
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <action id="Marimo.RunInSandbox"
                class="io.marimo.notebook.editor.RunInSandboxAction"
                text="Start marimo in Sandbox"
                description="Run this marimo notebook in an isolated uv environment"
                icon="io.marimo.notebook.MarimoIcons.FILE">
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <group id="Marimo.Session"
               class="io.marimo.notebook.editor.sessions.MarimoSessionActionGroup"
               text="Marimo Session"
               description="Manage the marimo session for this notebook"
               icon="io.marimo.notebook.MarimoIcons.FILE"
               popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </group>

        <action id="Marimo.OpenNotebook"
                class="io.marimo.notebook.editor.sessions.MarimoOpenNotebookAction"
                text="Open marimo Notebook"
                description="Open this notebook in the marimo editor"
                icon="AllIcons.Actions.Forward">
            <add-to-group group-id="Marimo.Session" anchor="first"/>
        </action>

        <action id="Marimo.RestartNotebook"
                class="io.marimo.notebook.editor.sessions.MarimoRestartNotebookAction"
                text="Restart marimo Session"
                description="Stop this notebook's marimo server and start a fresh one"
                icon="AllIcons.Actions.Restart">
            <add-to-group group-id="Marimo.Session" anchor="last"/>
        </action>

        <action id="Marimo.StopNotebook"
                class="io.marimo.notebook.editor.sessions.MarimoStopNotebookAction"
                text="Stop marimo Session"
                description="Stop this notebook's marimo server"
                icon="AllIcons.Actions.Suspend">
            <add-to-group group-id="Marimo.Session" anchor="last"/>
        </action>

        <group id="Marimo.Pair"
               class="io.marimo.notebook.pair.MarimoPairActionGroup"
               text="Pair with AI"
               description="Start an AI harness paired on this marimo notebook, or copy its prompt"
               icon="AllIcons.Actions.Lightning"
               popup="true">
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
