{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:monthly"],
  "minimumReleaseAge": "14 days",
  "labels": ["dependencies"],
  "pin": {
    "enabled": false
  },
  "rangeStrategy": "bump",
  "packageRules": [
    // Group all GitHub Actions dependencies. Actions are pinned to a commit SHA with a
    // version comment, so digest updates belong in the same group as version updates.
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "major", "digest"]
    },
    // Group Gradle minor and patch updates, including the Gradle wrapper.
    // Majors get their own pull request so each one can be reviewed on its own.
    {
      "groupName": "gradle-minor-patch",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
